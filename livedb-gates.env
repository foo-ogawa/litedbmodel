# The live-DB test gates — SSoT (#168).
#
# Every per-language test that talks to the dockerized Postgres/MySQL guards itself on one of these
# variables. Until this file existed each gate was named only inside the test that read it, no
# workflow set any of them, and so four whole suites (tx isolation, tx boundary, connection routing,
# middleware) reported green in CI without ever executing. Declaring them in ONE place makes the set
# auditable: `scripts/check-reachable-test-gates.mjs` fails if a test gates on a variable missing
# here, if a variable here gates no test, or if no PR/push workflow runs a command that loads this
# file. Both checkers read it through `scripts/livedb-gates.mjs`, which accepts exactly the lines
# CI's grep does.
#
# CI:    grep -E '^[A-Z][A-Z0-9_]*=' livedb-gates.env >> "$GITHUB_ENV"  (.github/workflows/conformance.yml)
# Local: npm run docker:livedb:up && set -a && . ./livedb-gates.env && set +a
#
# Opening a gate is not the same as PROVING it opened: a gated test that skips reports success, and a
# gated test edited to bail out some other way does not even report that. So EVERY suite runs through
# a RUN GATE — `npm run {ts,py,php,go,rust}:test` (`scripts/check-*-test-skips.mjs`) — in CI and in the
# RELEASING.md checklist alike. Each refuses to start unless every declaration below is set to that
# VALUE in its own environment, then owns the runner's argv and checks the runner's own machine-readable
# report against what the tree declares, with a skip budget of zero, so "green because it never ran"
# fails loudly (#219 go, #220 python/php/rust/TS). `check-reachable-test-gates.mjs` requires the
# workflow to invoke those gates and not the bare runners, which cannot report any of it.

# python/tests/test_conformance_corpus.py, php/tests/ConformanceCorpusTest.php — replay the frozen
# live corpus against real PG + MySQL.
LITEDBMODEL_LIVEDB=1

# rust/litedbmodel_runtime/tests/livedb_middleware.rs — the middleware layer on the live PG seam.
LITEDBMODEL_LIVEDB_PARALLEL=1

# rust/litedbmodel_runtime/tests/connection_routing.rs — reader/writer routing on live PG + MySQL.
LITEDBMODEL_PHASE_C=1

# rust/litedbmodel_runtime/tests/tx_unwind_release.rs — the tx's owned connection is released on every
# path, INCLUDING a body that panics, on live PG + MySQL.
LITEDBMODEL_TX_UNWIND=1

# rust/litedbmodel_runtime/tests/tx_boundary.rs — N ops in ONE transaction() are ONE physical
# transaction (one BEGIN, one COMMIT) on ONE connection the boundary OWNS, on live PG + MySQL.
LITEDBMODEL_TX_BOUNDARY=1

# go/litedbmodel_runtime/{tx_boundary,connection_routing,middleware}_livedb_test.go,
# python/tests/test_{tx_boundary_livedb,connection_routing_livedb,middleware_livedb}.py,
# rust/litedbmodel_runtime/tests/tx_isolation.rs — what the transaction is WORTH on real PG + MySQL:
# the isolation LEVEL reaching the server, a real lock cycle being retried (and a data conflict not),
# the write=tx guard, and a nested transaction() joining the outer one. Plus, for go and python, the
# connection routing and middleware legs.
LITEDBMODEL_TX_ISOLATION=1

# php/tests/{TxAtomicity,TxBoundary,ConnectionRouting,Middleware}LiveTest.php — INVERTED polarity:
# these run by default and skip when this is `1`. Pinned to `0` so a CI run can never be talked out
# of the live legs by an inherited environment.
LITEDBMODEL_SKIP_LIVE=0
