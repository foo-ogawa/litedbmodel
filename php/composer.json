{
    "name": "litedbmodel/runtime",
    "description": "litedbmodel v2 SCP PHP runtime — the leaf transport (executeSQL / pluckKeys / groupChildren), execution context, transactions and connection routing that a behavior-contracts php-native generated module calls. Semantics-identical to the TS reference.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "LiteDbModel\\Runtime\\": "src/"
        },
        "files": [
            "src/TxOptions.php",
            "src/ExecutionContext.php",
            "src/ConnectionRouting.php",
            "src/LiveDb.php",
            "src/Middleware.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "LiteDbModel\\Runtime\\Tests\\": "tests/",
            "LiteDbModel\\Bench\\": "orm_bench/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
