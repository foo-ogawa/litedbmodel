{
  "suite": "tx",
  "corpusVersion": 5,
  "note": "Write-time-relations gate-first transaction bundles: commit + gate short-circuit + composite tx-DAG.",
  "vectors": [
    {
      "name": "create: gate-first tx commits (author exists, unique, idempotent)",
      "kind": "tx",
      "dialect": "sqlite",
      "bundle": {
        "dialect": "sqlite",
        "name": "Create",
        "statement": {
          "sql": "INSERT INTO tx_posts (author_id, title) VALUES (?, ?) RETURNING id, author_id, title",
          "params": [
            {
              "ref": [
                "author_id"
              ]
            },
            {
              "ref": [
                "title"
              ]
            }
          ],
          "writeMeta": {
            "table": "tx_posts",
            "bindColumns": [
              "author_id",
              "title"
            ],
            "returning": [
              "id",
              "author_id",
              "title"
            ]
          }
        },
        "transaction": {
          "phase": "create",
          "entityFrom": "tx_body_3",
          "statements": [
            {
              "id": "tx_requires_0",
              "role": "gate:requires",
              "op": {
                "sql": "SELECT 1 FROM tx_users WHERE id = ?",
                "params": [
                  {
                    "ref": [
                      "author_id"
                    ]
                  }
                ]
              },
              "gate": "existsElseRollback",
              "label": "requires tx_users"
            },
            {
              "id": "tx_idem_1",
              "role": "gate:idempotency",
              "op": {
                "sql": "INSERT INTO tx_idem (token) VALUES (?) ON CONFLICT DO NOTHING",
                "params": [
                  {
                    "ref": [
                      "request_id"
                    ]
                  }
                ]
              },
              "gate": "insertedElseNoop",
              "label": "idempotency tx_idem"
            },
            {
              "id": "tx_unique_2",
              "role": "gate:unique",
              "op": {
                "sql": "INSERT INTO tx_uniq (name, s0, f0) VALUES (?, ?, ?) ON CONFLICT DO NOTHING",
                "params": [
                  "title_per_author",
                  {
                    "ref": [
                      "author_id"
                    ]
                  },
                  {
                    "ref": [
                      "title"
                    ]
                  }
                ]
              },
              "gate": "insertedElseRollback",
              "label": "unique title_per_author"
            },
            {
              "id": "tx_body_3",
              "role": "body",
              "op": {
                "sql": "INSERT INTO tx_posts (author_id, title) VALUES (?, ?) RETURNING id, author_id, title",
                "params": [
                  {
                    "ref": [
                      "author_id"
                    ]
                  },
                  {
                    "ref": [
                      "title"
                    ]
                  }
                ],
                "writeMeta": {
                  "table": "tx_posts",
                  "bindColumns": [
                    "author_id",
                    "title"
                  ],
                  "returning": [
                    "id",
                    "author_id",
                    "title"
                  ]
                }
              },
              "label": "Insert"
            },
            {
              "id": "tx_derive_4",
              "role": "derive",
              "op": {
                "sql": "UPDATE tx_users SET post_count = post_count + ? WHERE id = ?",
                "params": [
                  1,
                  {
                    "ref": [
                      "author_id"
                    ]
                  }
                ]
              },
              "label": "derive tx_users.post_count"
            },
            {
              "id": "tx_emit_5",
              "role": "emit",
              "op": {
                "sql": "INSERT INTO tx_outbox (type, payload) VALUES (?, ?)",
                "params": [
                  "PostCreated",
                  {
                    "obj": {
                      "postId": {
                        "ref": [
                          "__entity",
                          "id"
                        ]
                      },
                      "userId": {
                        "ref": [
                          "author_id"
                        ]
                      }
                    }
                  }
                ]
              },
              "label": "emit PostCreated"
            }
          ],
          "onIdempotentHit": "rollback"
        },
        "outputType": {
          "obj": {
            "committed": "bool",
            "executed": {
              "arr": "string"
            },
            "shortCircuit": {
              "opt": {
                "obj": {
                  "statementId": "string",
                  "reason": "string"
                }
              }
            },
            "entity": {
              "opt": {
                "obj": {
                  "id": "int",
                  "author_id": "int",
                  "title": "string"
                }
              }
            }
          }
        }
      },
      "input": {
        "author_id": 7,
        "title": "New Post",
        "request_id": "req-1"
      },
      "schema": [
        "CREATE TABLE tx_users (id INTEGER PRIMARY KEY, name TEXT, post_count INTEGER NOT NULL DEFAULT 0)",
        "CREATE TABLE tx_posts (id INTEGER PRIMARY KEY AUTOINCREMENT, author_id INTEGER NOT NULL REFERENCES tx_users(id), title TEXT NOT NULL)",
        "CREATE TABLE tx_idem (token TEXT PRIMARY KEY)",
        "CREATE TABLE tx_uniq (name TEXT NOT NULL, s0 INTEGER NOT NULL, f0 TEXT NOT NULL, PRIMARY KEY (name, s0, f0))",
        "CREATE TABLE tx_outbox (id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT NOT NULL, payload TEXT NOT NULL)",
        "INSERT INTO tx_users (id, name, post_count) VALUES (7, 'Ada', 2)",
        "INSERT INTO tx_users (id, name, post_count) VALUES (8, 'Alan', 0)"
      ],
      "expectedResult": {
        "committed": true,
        "entity": {
          "id": {
            "$bigint": "1"
          },
          "author_id": {
            "$bigint": "7"
          },
          "title": "New Post"
        },
        "executed": [
          "tx_requires_0",
          "tx_idem_1",
          "tx_unique_2",
          "tx_body_3",
          "tx_derive_4",
          "tx_emit_5"
        ]
      },
      "expectedDbState": [
        {
          "query": "SELECT id, author_id, title FROM tx_posts ORDER BY id",
          "rows": [
            {
              "id": {
                "$bigint": "1"
              },
              "author_id": {
                "$bigint": "7"
              },
              "title": "New Post"
            }
          ]
        },
        {
          "query": "SELECT id, post_count FROM tx_users ORDER BY id",
          "rows": [
            {
              "id": {
                "$bigint": "7"
              },
              "post_count": {
                "$bigint": "3"
              }
            },
            {
              "id": {
                "$bigint": "8"
              },
              "post_count": {
                "$bigint": "0"
              }
            }
          ]
        },
        {
          "query": "SELECT type, payload FROM tx_outbox ORDER BY id",
          "rows": [
            {
              "type": "PostCreated",
              "payload": "{\"postId\":1,\"userId\":7}"
            }
          ]
        }
      ]
    },
